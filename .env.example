APP_NAME=Image2EditablePPT
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://127.0.0.1:5173
OCR_PROVIDER=auto
SEGMENTATION_PROVIDER=auto
# Set an absolute, external path to enable real local SAM2. Never sync weights.
SAM_MODEL_PATH=
SAM_DEVICE=cpu
INPAINT_PROVIDER=opencv
# Local IOPaint / LaMa is preferred for masked background repair when enabled.
# The backend reads the running service's OpenAPI schema before calling it.
LOCAL_INPAINT_ENABLED=false
LOCAL_INPAINT_URL=http://127.0.0.1:8080
LOCAL_INPAINT_MODEL=lama
RECONSTRUCTION_SURFACE_MODE=exclusive_object_first
# Automatic revisions are deliberately paused in code during ownership audit.
# Optional professional masked inpainting: set INPAINT_PROVIDER=stability and
# supply a separate Stability AI key. The default never calls a paid inpainting API.
STABILITY_API_KEY=
MAX_UPLOAD_MB=25

# Multi-provider vision routing. Never put a real API key in source control.
VISION_PROVIDER=auto_free
GEMINI_API_KEY=
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_FLASH_LITE_MODEL=gemini-2.5-flash-lite
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=qwen3-vl-flash
QWEN_ENABLE_THINKING=false
QWEN_TIMEOUT=120
QWEN_MAX_RETRIES=2
MAX_AI_CALLS_PER_SLIDE=3
