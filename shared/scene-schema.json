{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://image2editableppt.local/schema/scene.json",
  "title": "Image2EditablePPT canonical Scene Graph",
  "description": "Scene 3.0 uses Layout JSON.elements as its sole mutable graph; canvas/bbox are derived projections. Legacy candidate scenes remain readable.",
  "type": "object",
  "required": ["version", "elements"],
  "properties": {
    "version": { "type": "string" },
    "sceneVersion": { "type": ["string", "null"] },
    "slide": { "type": "object" },
    "metadata": { "type": "object" },
    "canvas": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "backgroundColor": { "type": "string" }
      }
    },
    "regions": { "type": "array", "items": { "type": "object" } },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "bbox", "rotation", "zIndex"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "role": { "type": ["string", "null"] },
          "bbox": { "type": "object" },
          "rotation": { "type": "number" },
          "zIndex": { "type": "number" },
          "groupId": { "type": ["string", "null"] },
          "editable": { "type": "boolean" },
          "owner": { "enum": ["editable_text", "native_shape", "movable_image", "background", "intentional_ignore", null] },
          "mask": { "type": ["string", "null"] },
          "contour": { "type": ["array", "null"] },
          "parent": { "type": ["string", "null"] },
          "assetPath": { "type": ["string", "null"] },
          "source": { "type": ["string", "null"] },
          "reconstructionStrategy": { "type": ["string", "null"] },
          "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
        }
      }
    },
    "groups": { "type": "array", "items": { "type": "object" } },
    "relations": { "type": "array", "items": { "type": "object" } },
    "styleTokens": { "type": "object" },
    "confidence": { "type": "object" }
  }
}
